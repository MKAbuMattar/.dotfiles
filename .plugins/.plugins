#!/usr/bin/env bash

# ==========================
# Plugin System
# ==========================

# Base directory where plugins are stored
PLUGIN_BASE_DIR="${HOME}/.config/.dotfiles/.plugins"
ZSH_PLUGIN_DIR="${PLUGIN_BASE_DIR}/.zsh"
PYTHON_PLUGIN_DIR="${PLUGIN_BASE_DIR}/.python"

# Resolve the best available Python 3 interpreter once at source time.
# Override by exporting DOTFILES_PYTHON before sourcing ~/.zshrc.
if [[ -z "${DOTFILES_PYTHON:-}" ]]; then
    for _py in python3.14 python3.13 python3.12 python3.11 python3.10 python3.9 python3 python; do
        if command -v "$_py" >/dev/null 2>&1; then
            DOTFILES_PYTHON="$_py"
            break
        fi
    done
    unset _py
fi
export DOTFILES_PYTHON

# Function to load plugins
load_plugins() {
    local plugins=("$@")
    local py="${DOTFILES_PYTHON:-python3}"

    for plugin in "${plugins[@]}"; do
        local loaded=false

        # Check for ZSH plugins in .zsh directory
        local zsh_plugin_path="${ZSH_PLUGIN_DIR}/${plugin}"
        if [[ -f "${zsh_plugin_path}/${plugin}.zsh" ]]; then
            source "${zsh_plugin_path}/${plugin}.zsh"
            loaded=true
        elif [[ -f "${zsh_plugin_path}/${plugin}.plugin.zsh" ]]; then
            source "${zsh_plugin_path}/${plugin}.plugin.zsh"
            loaded=true
        elif [[ -f "${zsh_plugin_path}/init.zsh" ]]; then
            source "${zsh_plugin_path}/init.zsh"
            loaded=true
        elif [[ -d "${zsh_plugin_path}" ]]; then
            for file in "${zsh_plugin_path}"/*.zsh(N); do
                source "$file"
                loaded=true
            done
        fi

        # Check for Python plugins in .python directory and create aliases.
        # Refuse to shadow common shell builtins / keywords — doing so breaks
        # nvm, compinit, hash -r, etc.  A plugin that wants those names must
        # be renamed in its own directory (e.g. `hash` → `hasher`).
        local python_plugin_path="${PYTHON_PLUGIN_DIR}/${plugin}"
        local _reserved=(hash cd pwd echo printf read test type which command builtin source eval exec exit jobs kill set unset export local declare typeset alias unalias bind history fg bg wait time)
        if [[ -f "${python_plugin_path}/main.py" || -f "${python_plugin_path}/${plugin}.py" || -f "${python_plugin_path}/init.py" ]]; then
            if (( ${_reserved[(I)$plugin]} )); then
                echo "Warning: Python plugin '${plugin}' shadows a shell builtin; skipping. Rename the plugin directory." >&2
            else
                # Make sure we're not stacking on a stale function from a
                # previous source (e.g. the directory was renamed since).
                unfunction "${plugin}" 2>/dev/null
                unalias    "${plugin}" 2>/dev/null
                if [[ -f "${python_plugin_path}/main.py" ]]; then
                    eval "${plugin}() { ${py} '${python_plugin_path}/main.py' \"\$@\"; }"
                elif [[ -f "${python_plugin_path}/${plugin}.py" ]]; then
                    eval "${plugin}() { ${py} '${python_plugin_path}/${plugin}.py' \"\$@\"; }"
                else
                    eval "${plugin}() { ${py} '${python_plugin_path}/init.py' \"\$@\"; }"
                fi
                loaded=true
            fi
        fi

        if [[ "$loaded" = false ]]; then
            echo "Warning: Plugin '${plugin}' not found in ${ZSH_PLUGIN_DIR} or ${PYTHON_PLUGIN_DIR}"
        fi
    done
}

# Export the function so it can be used
export -f load_plugins 2>/dev/null || true
